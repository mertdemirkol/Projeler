#define DNS_PORT 53
#define HTTP_CODE 200
#define TICK_TIMER 1000
IPAddress APIP(172, 0, 0, 1);  


String credentialsData = "";
bool savedData = false;
unsigned long bootTime = 0, lastActivity = 0, lastTick = 0;
int timer = 5000;
int i = 0;

DNSServer dnsServer;
ESP8266WebServer webServer(80);

